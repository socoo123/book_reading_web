      "isDeleted": false,
      "boundElements": null,
      "updated": 1794049815807,
      "link": null,
      "locked": false,
      "text": "② 为当前读记录安全读位置\n等待与该读匹配的多数派确认\n得到可使用的 readIndex",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "yEzHNPLOfWYC7H1jGtOVJ",
      "originalText": "② 为当前读记录安全读位置\n等待与该读匹配的多数派确认\n得到可使用的 readIndex",
      "autoResize": true,
      "lineHeight": 1.15
    },
