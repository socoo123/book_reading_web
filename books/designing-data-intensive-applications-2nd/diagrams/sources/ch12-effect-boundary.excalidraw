      "text": "保证只能延伸到接收方实际承诺的动作，不能延伸到用户行为。",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "保证只能延伸到接收方实际承诺的动作，不能延伸到用户行为。",
      "autoResize": true,
      "lineHeight": 1.15
    },
